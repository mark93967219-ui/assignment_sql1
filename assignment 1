Create Table
CREATE TABLE IF NOT EXISTS Shop (
    Shop_ID INT PRIMARY KEY,
    Shop_Name VARCHAR(100) NOT NULL,
    Product_Name VARCHAR(100) NOT NULL,
    Price DECIMAL(10,2) DEFAULT 10.00
);

